# PostgreSQL (Neon) connection string
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"

# Signs API access/refresh tokens. Generate with: openssl rand -hex 32
JWT_SECRET=""

# Browser origins allowed to call the API directly (comma separated).
# Not needed for the mobile apps or for the web frontend, which calls server-to-server.
CORS_ORIGINS="http://localhost:3000"

# Optional token lifetimes, in seconds (defaults: 8 hours / 30 days)
# ACCESS_TOKEN_TTL_SECONDS=28800
# REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional: where /api/security/backups writes snapshot files (default ./backups)
# BACKUP_DIR=""
