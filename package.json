    "db:studio": "prisma studio",
    "db:check": "node check-db.js"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "date-fns": "3.0.6",
    "jose": "5.9.6",
    "next": "14.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.10.0",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "prisma": "5.20.0",
    "typescript": "5.3.3"
  }
